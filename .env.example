# --- Gemini（ゲーム内AIプレイヤー／審判）---
# https://aistudio.google.com/apikey で取得
GEMINI_API_KEY=
# 任意。既定は gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase（全端末リアルタイム同期。未設定でもローカル同期モードで遊べます）---
# supabase/schema.sql を SQL Editor で実行してから設定してください
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- コード実行（任意）---
# 公開 Piston API は whitelist 制のため、自前ホストする場合のみ設定
# 未設定ならブラウザ内 sandbox iframe で実行されます
PISTON_URL=
