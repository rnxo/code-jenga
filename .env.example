# .env.local を作る際のテンプレート。値は各自で設定すること（コミットしない）。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# service role キー。Supabase ダッシュボード > Project Settings > API から取得する。
# 絶対にクライアントへ渡さない（src/lib/supabase/admin.ts の "server-only" で境界を強制している）。
SUPABASE_SERVICE_ROLE_KEY=

# BE-B 担当: お題生成用の Gemini API キー。
GEMINI_API_KEY=
# Geminiモデル名（未指定時は gemini-3.6-flash。gemini-2.5-flash は提供終了で 404 になる）
GEMINI_MODEL=gemini-3.6-flash

# BE-B 担当: Piston（コード実行）API のベース URL（末尾に /execute は付けない）。
# 公開インスタンス https://emkc.org/api/v2/piston は 2026/2/15 からホワイトリスト制で 401 を返すため、
# piston/docker-compose.yml でセルフホストしたものを使う。
PISTON_API_URL=http://localhost:2000/api/v2
# 公開版（piston/docker-compose.public.yml、デモは scripts/start-demo-tunnel.ps1）を使うときの共有キー（任意）。
# Piston 側の PISTON_API_KEY と同じ値を設定すると X-Piston-Key ヘッダーで送る。ローカル直結なら空のままでよい。
PISTON_API_KEY=
# Piston に渡す言語とバージョンの上書き（任意）。
# 重要: この2つは TypeScript のお題にのみ適用される。言語を増やしたあとも全言語に効かせると
# Python のお題まで deno に送られて必ず失敗するため、旧来の変数名は typescript 専用にしている
# （src/lib/server/piston/languages/env.ts）。既定は deno（型チェック無し・compile ステージ無しで判定が単純）。
# language=typescript version=* だと tsc 5.0.3（target ES5）が選ばれるので注意。
PISTON_LANGUAGE=deno
PISTON_LANGUAGE_VERSION=*
# 言語ごとの上書き（任意）。未設定なら言語定義の既定値（python は language=python / version=*）を使う。
# 旧来の PISTON_LANGUAGE より優先される。
# PISTON_LANGUAGE_PYTHON=python
# PISTON_LANGUAGE_VERSION_PYTHON=3.12.0
# Piston にリクエストで渡す実行制限（ms、任意）。piston/docker-compose.yml の
# PISTON_RUN_TIMEOUT / PISTON_COMPILE_TIMEOUT 以下にすること（超えると Piston が 400 を返す）。
# fetch のタイムアウトは max(10秒, run + compile + 5秒) で自動計算される。
PISTON_RUN_TIMEOUT_MS=3000
PISTON_COMPILE_TIMEOUT_MS=10000

# true にすると src/lib/api/client.ts が Route Handler の代わりに
# src/lib/api/mock.ts のモックレスポンスを返す（フロント単体開発用）。
NEXT_PUBLIC_USE_MOCK_API=true
